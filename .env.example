# =============================================================================
# DEEP Portfolio — docker compose environment
# =============================================================================
# Copy to .env and fill in the blanks. Never commit .env.
#
#     cp .env.example .env
#     docker compose up --build
#
# This file is read by docker-compose.yml ONLY. It is not the API's .env — that
# one is apps/api/.env, and it is for running the API straight on the host with
# `npm run dev`. The two cannot be merged: the same setting needs a different
# value in each. Inside the compose network the database is at `db:5432`; from
# the host it is at `localhost:5432`.
#
# Only credentials live here. Hostnames, ports and everything else the compose
# network decides for itself are literals in docker-compose.yml.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
# Required — compose refuses to start without it. Any value will do locally;
# nothing outside your machine can reach this database.
POSTGRES_PASSWORD=

# OPTIONAL — defaults: postgres, deep_portfolio. Changing either after the first
# `docker compose up` has no effect until the db-data volume is removed, because
# Postgres only reads them when it initialises an empty data directory:
#   docker compose down -v
POSTGRES_USER=postgres
POSTGRES_DB=deep_portfolio

# --- MinIO -------------------------------------------------------------------
# Required. These are both the MinIO server's own root credentials and the
# credentials the API signs its requests with — compose passes them through as
# MINIO_ACCESS_KEY / MINIO_SECRET_KEY.
# MINIO_ROOT_PASSWORD must be at least 8 characters or MinIO refuses to start.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# OPTIONAL — default deep-portfolio. Created on startup by the minio-init service.
MINIO_BUCKET=deep-portfolio

# --- API secrets -------------------------------------------------------------
# Required. Generate each with:  openssl rand -base64 48
# There is deliberately no fallback anywhere in the code: a missing secret must
# crash the server, not silently accept forgeable tokens.
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Google sign-in ----------------------------------------------------------
# Required. The OAuth client id for the whole stack: the API refuses any Google
# ID token not issued for this exact client, and the web app uses it to ask
# Google for one. Both services read the same value.
#
# Not a secret — a client id is public by design and ends up in the web bundle.
# There is no client secret in this flow: the browser gets the ID token straight
# from Google and the API only verifies it (issue #11).
#
# Create one at https://console.cloud.google.com/apis/credentials as an OAuth
# client of type "Web application", listing the web app's origin
# (http://localhost:3000 locally) under Authorised JavaScript origins.
GOOGLE_CLIENT_ID=

# OPTIONAL — default blank. Domain attribute of the session cookies. Blank makes
# them host-only, i.e. sent back only to the host that set them, which is what
# you want unless the API and the web app are on different subdomains of one
# domain. Set it to that shared domain (".example.ac.th") if they are.
COOKIE_DOMAIN=

# --- Email -------------------------------------------------------------------
# OPTIONAL. Gmail account used to send group-invite emails. Leaving these blank
# is fine: the send is wrapped in try/catch, so groups are still created and the
# invite simply never arrives.
EMAIL_USER=
EMAIL_PASS=

# --- Published ports ---------------------------------------------------------
# OPTIONAL. Host-side ports only — the ports inside the compose network are
# fixed. Change one when something else on this machine already owns it.
#
# These are not cosmetic. Every URL that depends on a port is derived from the
# variable, so raising WEB_PORT also moves the origin the API allows through
# CORS, and raising API_PORT also moves the URL baked into the web bundle.
# Changing API_PORT or WEB_PORT therefore needs `docker compose up --build web`.
WEB_PORT=3000
API_PORT=4001
DB_PORT=5432
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9001
