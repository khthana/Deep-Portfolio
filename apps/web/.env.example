# =============================================================================
# DEEP Portfolio - Web environment
# =============================================================================
# Copy to .env and fill in real values. Never commit .env.
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Anything put here is PUBLIC once the app is built. Never put a secret here.
# =============================================================================

# Base URL of the API, used by the axios instance.
VITE_BACKEND_URL=http://localhost:4001

# Google OAuth client id, used by the login page to ask Google for an ID token.
# Must be the SAME value as GOOGLE_CLIENT_ID in the API's environment: the API
# rejects any token that was issued for a different client. Public by design —
# a client id is not a client secret, and this flow has no client secret at all.
VITE_GOOGLE_CLIENT_ID=
