# =============================================================================
# DEEP Portfolio - API environment
# =============================================================================
# Copy to .env and fill in real values. Never commit .env.
#
# Every variable below is read somewhere in the code. Values shown are safe
# local-development placeholders, NOT production values.
#
# src/config/env.ts is the only module that reads process.env. It resolves and
# validates everything once at startup, so a missing required value crashes the
# server immediately with a list of what is missing, rather than failing later
# on whichever request touches it first. Variables marked OPTIONAL below have a
# default or may be left blank; everything else is required.
# =============================================================================

# --- Server ------------------------------------------------------------------
# OPTIONAL — defaults: development, 4001
NODE_ENV=development
PORT=4001

# OPTIONAL — default http://localhost:3000. Origin allowed by CORS, and the base
# of the invite links sent by email. Must match where the web app is served from.
CLIENT_URL=http://localhost:3000

# --- Database ----------------------------------------------------------------
# Prisma reads DATABASE_URL, and it is now the only database setting there is.
# The discrete DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD variables are
# gone: the only module that read them was src/config/db.ts, which nothing
# imported and which has been deleted (see spec D8).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/deep_portfolio?schema=public

# --- Auth --------------------------------------------------------------------
# Generate with: openssl rand -base64 48
# There is deliberately no fallback in code: a missing secret must crash
# the server, not silently accept forgeable tokens.
JWT_SECRET=
JWT_REFRESH_SECRET=

# Shared secret used to verify the SSO cookie minted by DEEP Core. Required:
# it is the only login path that exists today. Being removed when Google OAuth
# lands (see spec D3).
DEEP_CORE_SECRET=

# --- Object storage (MinIO) --------------------------------------------------
# Credentials for the MinIO server itself. Consumed by docker-compose, NOT by
# the API — src/config/env.ts does not read these two.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Credentials the API uses to talk to MinIO (same values as above locally).
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

MINIO_ENDPOINT=localhost

# OPTIONAL — defaults: 9000, deep-portfolio
MINIO_PORT=9000
MINIO_BUCKET=deep-portfolio

# Presigned URLs come back pointing at the in-network host, which a browser
# cannot resolve. The API rewrites INTERNAL -> PUBLIC before returning them.
MINIO_INTERNAL_HOST=minio:9000
MINIO_PUBLIC_HOST=localhost:9002

# --- Email -------------------------------------------------------------------
# Gmail account used to send group-invite emails. This IS live: creating or
# updating a student activity group sends an invite to every member, via
# src/config/mailer.ts. (An earlier note here claimed nodemailer was dead code
# — that was wrong, see spec D8.)
#
# OPTIONAL. Leaving these blank does not break group creation: the send is
# wrapped in try/catch and a failure is logged, not propagated. The group is
# still created, the invite email just never arrives. They are deliberately not
# required, so a blank mail account must not stop the server from starting.
EMAIL_USER=
EMAIL_PASS=
