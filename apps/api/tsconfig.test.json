// Typechecking for the test suite only. Separate from tsconfig.json because
// that one is the build: rootDir is ./src and include is src/**/*.ts, so the
// compiled output must not grow a test/ directory.
//
// The module settings differ too. The build emits CommonJS for node; Vitest
// evaluates these files as ES modules through Vite, so they may use top-level
// await and import.meta — neither of which typechecks under "commonjs".
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "types": ["node", "vitest/globals"]
  },
  "include": ["test/**/*.ts", "vitest.config.ts"]
}
